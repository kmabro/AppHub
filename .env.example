# Neon Postgres connection string (use the pooled endpoint)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER/DB?sslmode=require

# Random 32+ byte secret used to sign session cookies
SESSION_SECRET=replace-with-a-long-random-string

# Neon Object Storage (S3-compatible) credentials
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.c-8.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=YOUR_TOKEN_ID
AWS_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_BUCKET=apphub

# Optional: public site URL used in QR codes (e.g. https://your-app.vercel.app)
# Leave blank to use whatever address the visitor is on.
NEXT_PUBLIC_SITE_URL=

# Resend email API (for verification and password reset emails)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=AppHub <onboarding@resend.dev>
